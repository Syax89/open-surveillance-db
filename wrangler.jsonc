{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-surveillance-db",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": { "binding": "IMAGES" },
  // Request analytics (Workers Analytics Engine, dataset osdb_requests):
  // one datapoint per request with path group (api|web), status class, API
  // endpoint (query string stripped) and HTTP method — nothing else. No
  // IPs, no user data, no query strings, and the website is counted only
  // as "web" (no per-page tracking). Consumed by the local monitoring
  // stack (Prometheus exporter + Grafana osdb-overview) via the Analytics
  // Engine SQL API. Workers Paid includes 10M datapoints written / month —
  // OSDB's traffic costs nothing extra. Local dev / tests: binding absent
  // from env -> logging is a no-op (docs/DEVELOPMENT_SETUP.md).
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "osdb_requests"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      // Transactional mail (AUTH MULTI-METODO Fase A2, ADR 0020): the only
      // allowed sender is the noreply address on the onboarded domain —
      // restricting the binding is defence in depth: even a compromised
      // worker cannot send from any other address. Recipients are arbitrary
      // contributor addresses (verification / password reset), so no
      // destination allowlist. The binding is simulated locally by wrangler
      // (emails are logged, not sent) unless `remote: true` is set.
      "allowed_sender_addresses": ["noreply@opensurveillancedb.org"]
    }
  ],
  "triggers": {
    // Retention sweep 03:00 UTC + every-minute keep-warm tick: the site has
    // low traffic (~4k req/day) and the edge cache absorbs the API probes,
    // so the worker used to sit idle for minutes between origin requests —
    // every visitor paid a ~700-1000ms cold start (observed: wallTime p99
    // 1.45s, warm origin 50-80ms). The every-minute cron wakes an isolate
    // so the first request after idle is served warm. The tick itself is a
    // no-op in the scheduled handler (see worker/index.ts WARMUP_CRON).
    "crons": ["0 3 * * *", "*/1 * * * *"]
  },
  // Cloudflare Workers Rate Limiting bindings (audit #3 MEDIUM, t_dff3dadf):
  // the PRODUCTION enforcement point for the five critical public route
  // families — auth, write (submissions), read, tiles, geocode. Before this the
  // buckets were per-isolate in-memory (app/lib/rate-limit.ts): on a
  // multi-isolate deployment a caller could spread a burst across isolates
  // to bypass the ceiling. The binding's counters are enforced by Cloudflare
  // edge infrastructure shared across isolates (per Cloudflare location).
  //
  // - namespace_id: a SELF-DEFINED positive integer (string), unique per
  //   Cloudflare account — no API resource to create (see Cloudflare docs
  //   "Rate Limiting binding"). Bindings sharing an id share counters; these
  //   five ids are dedicated to this worker. Change them only if they
  //   collide with an existing binding on the account.
  // - simple.limit / simple.period: the effective thresholds in production.
  //   The values mirror the CURRENT per-family defaults (ROUTE_LIMIT_DEFAULTS
  //   in app/lib/rate-limit.ts; the env knobs are ignored for these four
  //   families while a binding is present). Final thresholds pending sign-off
  //   by the maintainer (t_dff3dadf). period must be 10 or 60; all defaults are 60s.
  // - Local dev / tests: bindings absent from env -> in-memory fallback
  //   (documented in docs/DEVELOPMENT_SETUP.md and app/lib/rate-limit.ts).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1201", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1202", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1203", "simple": { "limit": 60, "period": 60 } },
    { "name": "TILES_LIMITER", "namespace_id": "1204", "simple": { "limit": 240, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1205", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osdb-production",
      // Clean template: the production D1 ID stays a placeholder here. The
      // real ID is injected by CI, while the operational LXC preserves it in
      // its uncommitted config and enables `remote: true` only through
      // scripts/enable-d1-authoritative.mjs (ADR 0022). Never commit either.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
