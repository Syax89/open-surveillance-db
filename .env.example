# .env.example — variabili per il tooling di sviluppo locale (vite/vinext,
# script QA). NESSUN segreto qui: le variabili del worker vanno in
# `.dev.vars` (vedi `.dev.vars.example`). Copia in `.env` se servono.

# Domini serviti dal dev server dietro reverse proxy (comma-separated).
# Senza questa variabile il fallback accetta solo localhost/IP locali.
# ALLOWED_HOSTS=your-host.example.org

# URL canonico pubblico per la generazione dei metadata (SSR).
# Assente = nessun metadataBase (raccomandato in sviluppo).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PORT=3000
# HOST=0.0.0.0
# BASE_URL=
# PROVISION_ACCOUNTS=
# CHROME_PATH=            # Lighthouse/QA: percorso del browser
# PLAYWRIGHT_PATH=
# COVERAGE_LINES=75
# CODEX_SANDBOX=
