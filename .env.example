# Example environment for local development — copy to `.dev.vars` (gitignored)
# and fill in real values. Nothing here is a secret; every value shown is a
# safe local default. Production values come from Cloudflare secrets / CI,
# never from this file.
#
# `wrangler dev` / `npm run dev` load `.dev.vars` automatically. Do not commit
# `.dev.vars`; commit changes to this file instead.

# Development mode flag (fail-closed). Only the exact value "development"
# opens dev-only behaviours (demo records on public surfaces, moderation demo
# actor selector). Unset or any other value behaves as production.
ENVIRONMENT=development

# Public base URL used to build email action links (verification, password
# reset). Required by the mailer; fail-closed when missing.
VERIFY_BASE_URL=http://localhost:3000

# Session cookie policy. In development over plain HTTP the cookie must NOT
# be Secure; production with the variable unset defaults to Secure.
AUTH_COOKIE_SECURE=false

# Optional overrides (see worker-configuration.d.ts for every variable):
# TILE_PROVIDER_URL / TILE_PROVIDER_KEY / TILE_UPSTREAM_TIMEOUT_MS / TILE_MAX_BYTES
# GEOCODER_BASE_URL / GEOCODE_RATE_LIMIT_MAX / GEOCODE_RATE_LIMIT_WINDOW_SECONDS
# EMAIL_SEND_LIMIT_MAX / EMAIL_SEND_LIMIT_WINDOW_SECONDS
# AUTH_SESSION_TTL_DAYS / AUTH_RATE_LIMIT_MAX / AUTH_RATE_LIMIT_WINDOW_SECONDS
# REGISTER_IP_RATE_LIMIT_MAX / REGISTER_IP_RATE_LIMIT_WINDOW_SECONDS
# REGISTRATION_IP_HMAC_KEY / CACHE_PURGE_TOKEN / CACHE_PURGE_ZONE_ID

# Moderation gate (ADR 0002): at least one credential pair must be set or the
# moderation surface answers 503 (fail-closed). Local testing only.
# MODERATION_USER=moderator
# MODERATION_PASSWORD=change-me
# MODERATION_TOKEN=
# MODERATION_OPERATORS=[{"user":"moderator","password":"change-me","email":"moderator@example.org"}]
# MODERATION_IDENTITY_EMAIL=moderator@example.org

# Multi-method authentication (ADR 0020): OIDC providers are active only when
# BOTH the client id and secret are set (server-gated, fail-closed).
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_PUBLIC_ORIGIN=http://localhost:3000
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# D1 database name for local wrangler dev (wrangler creates it on first run).
# DB_LOCAL=osdb-local
