{
  "name": "open-surveillance-db",
  "version": "0.1.0",
  "description": "Open, non-commercial civic database of visible public surveillance infrastructure.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syax89/open-surveillance-db.git"
  },
  "homepage": "https://github.com/Syax89/open-surveillance-db",
  "bugs": {
    "url": "https://github.com/Syax89/open-surveillance-db/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview:serve": "node scripts/serve-preview.mjs",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "coverage": "bash -c 'set -euo pipefail; npm run build; rm -rf .coverage && mkdir -p .coverage; OSDB_COVERAGE_TREE=1 NODE_V8_COVERAGE=.coverage/raw node --test --experimental-test-coverage --test-coverage-include=\".coverage/trees/osdb-routes-*/app/**\" --test-coverage-include=\".coverage/trees/osdb-routes-*/db-real/**\" --test-coverage-include=\".coverage/trees/osdb-e2e-*/app/**\" --test-coverage-include=\".coverage/trees/osdb-e2e-*/db/**\" --test-coverage-include=\".coverage/trees/osdb-e2e-*/worker.mjs\" --test-coverage-include=\".coverage/trees/osdb-db-runtime-*/**\" --test-coverage-include=\".coverage/trees/osdb-freshness-*/**\" --test-coverage-exclude=\".coverage/trees/**/cloudflare-workers.mjs\" --test-coverage-exclude=\".coverage/trees/**/geocode.mjs\" --test-coverage-exclude=\".coverage/trees/**/vinext-*-stub.mjs\" --test-coverage-exclude=\"**/node_modules/**\" \"tests/*.test.mjs\" 2>&1 | tee .coverage/coverage.txt'",
    "coverage:docs": "bash -c 'npx c8 report --temp-directory=.coverage/raw --report-dir=.coverage/report --reporter=json --reporter=text-summary > .coverage/c8-summary.txt && node scripts/coverage-docs.mjs --check'",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .coverage --ignore-pattern .worktrees",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply osdb-production --local",
    "db:smoke": "node scripts/db-migration-smoke.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:provision": "node scripts/provision-alpha-accounts.mjs",
    "db:seed": "wrangler d1 execute osdb-production --local --file=scripts/demo-cameras.sql --yes",
    "import:run": "node scripts/import/cli.mjs run",
    "import:rollback": "node scripts/import/cli.mjs rollback"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "fzstd": "^0.1.1",
    "hyparquet": "^1.28.1",
    "leaflet": "^1.9.4",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.10.0",
    "c8": "^10.1.3",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.1",
    "miniflare": "5.20260730.0-alpha",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.18"
  }
}
