# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.coverage/

# kanban git worktrees (per-task, mai da committare)
/.worktrees/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wrangler local dev secrets (never commit moderation credentials)
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
tsconfig.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# dom harness transpile tree (tests/.dom-tmp-*)
tests/.dom-tmp-*
tests/ssr-snap15.tmp.mjs

# lighthouse CI local runs (kanban t_2d2bf33f)
/.lighthouseci/

# secrets / credentials — completano *.pem qui sopra (mai committare)
*.key
*.gpg
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.kdbx

# backup / editor swap / temporanei
*.bak
*.orig
*.tmp
*.swp
*.swo
*~

# env templates: il template È committato, i valori no
!.env.example
.dev.vars.*
!.dev.vars.example

# tooling personale del maintainer (non parte del template)
/.claude/
/.vscode/
/.idea/
