# Cloudflare Workers static-asset headers (copied by Vite from public/ to
# dist/client/_headers; the worker never runs for these paths because the
# assets binding answers them first). Perf 2026-11.
#
# IMPORTANT: vinext writes its own dist/client/_headers ONLY when none exists,
# so this file must keep the immutable rule for the content-hashed bundle.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed brand/social assets: one day of browser + edge cache instead of
# max-age=0, must-revalidate. HTML is never served from public/, so pages
# keep their own no-store policy.
/favicon.svg
  Cache-Control: public, max-age=86400
/logo-dark.svg
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# Explorer-only View Transition stylesheet (render-blocking on /mappa and
# /directory): unhashed, so a shorter window bounds staleness after a deploy.
/explorer-view-transition.css
  Cache-Control: public, max-age=3600
