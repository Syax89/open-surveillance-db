          }
        ],
        "responses": {
          "200": {
            "description": "Confirmation cast"
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the confirm scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Write"
        ],
        "summary": "Withdraw a community confirmation",
        "operationId": "confirmationDelete",
