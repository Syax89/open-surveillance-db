    "/api/corrections": {
      "post": {
        "tags": [
          "Write"
        ],
        "summary": "Submit a correction or removal request",
        "operationId": "correctionsSubmit",
        "description": "Requires a private API key with scope `submit`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cameraId",
                  "reason"
                ],
                "properties": {
                  "cameraId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Correction submitted"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the submit scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras/search": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "Text search across titles, addresses and kinds",
        "operationId": "camerasSearch",
        "description": "Fast way to find a specific camera without scanning the map.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching cameras.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraList"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid q",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras/nearby": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "Cameras near a position, sorted by distance",
        "operationId": "camerasNearby",
        "description": "The duplicate check used by the report form.",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Search radius in meters (default 200).",
            "schema": {
              "type": "number",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cameras sorted by distance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraList"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras/revisions": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "Public change history of a record",
        "operationId": "camerasRevisions",
        "description": "What changed on a camera, when, and by whom (anonymous or contributor).",
        "parameters": [
          {
            "name": "cameraId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revision list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "cameraId": {
                        "type": "integer"
                      },
                      "changedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "changedBy": {
                        "type": "string",
                        "nullable": true
                      },
                      "summary": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid cameraId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/geocode": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "Place autocomplete",
        "operationId": "geocodeGet",
        "description": "Proxied to OpenStreetMap Nominatim. Results are cached, so repeat queries never hit the upstream.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place query.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Place suggestions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "latitude": {
                        "type": "number"
                      },
                      "longitude": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid q",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/geocode/reverse": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "Closest address for a position",
        "operationId": "geocodeReverse",
        "description": "The same lookup that fills the address field in the report form.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Closest address.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string"
                    },
                    "latitude": {
                      "type": "number"
                    },
                    "longitude": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tiles/{z}/{x}/{y}.png": {
      "get": {
        "tags": [
          "Tiles"
        ],
        "summary": "OpenStreetMap raster tile",
        "operationId": "tileGet",
        "description": "OSM raster tiles, proxied and cached. Use them to build your own map over the camera data.",
        "parameters": [
          {
            "name": "z",
            "in": "path",
            "required": true,
            "description": "Zoom level 0-19.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19
            }
          },
          {
            "name": "x",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "y",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG tile.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/import-sources": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "Committed import batches (source attribution)",
        "operationId": "importSourcesGet",
        "description": "Resolves an imported record's raw source ('import:<slug>') to readable attribution info: entity name, licence + link, dataset link. Serves only committed batches.",
        "responses": {
          "200": {
            "description": "Source attribution list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slug": {
                            "type": "string"
                          },
                          "sourceName": {
                            "type": "string"
                          },
                          "sourceUrl": {
                            "type": "string"
                          },
                          "license": {
                            "type": "string"
                          },
                          "licenseUrl": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private write API key, created in the account settings. Each endpoint requires the scope shown in its documentation."
      }
    },
    "schemas": {
      "Camera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string",
            "nullable": true
          },
          "observedOn": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "direction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359,
            "nullable": true,
            "description": "Compass bearing in degrees clockwise from north; null for non-directional or unknown. Domes are always null."
          }
        }
      },
      "CameraList": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Camera"
            }
          },
          "total": {
            "type": "integer",
            "nullable": true,
            "description": "Full-set count, or null when count=false was passed."
          },
          "nextOffset": {
            "type": "integer",
            "nullable": true,
            "description": "Offset of the next page; null when there are no more records. Walk pages on nextOffset (it is the pagination source of truth, not total)."
          }
        }
      },
      "FeatureCollection": {
        "type": "object",
        "description": "GeoJSON FeatureCollection (RFC 7946) with ODbL foreign members.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "Feature"
                  ]
                },
                "geometry": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "Point"
                      ]
                    },
                    "coordinates": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      },
                      "description": "[longitude, latitude]"
                    }
                  }
                },
                "properties": {
                  "$ref": "#/components/schemas/Camera"
                }
              }
            }
          }
        }
      },
      "CameraSubmission": {
        "type": "object",
        "description": "Fields accepted by the write API. The full validation rules mirror the site forms.",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "maxLength": 60
          },
          "manufacturer": {
            "type": "string",
            "maxLength": 100
          },
          "observedOn": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "address": {
            "type": "string",
            "maxLength": 300
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "direction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359,
            "description": "Ignored (normalised to null) for dome kinds."
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "opensurveillancedb"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message."
          }
        }
      }
    }
  }
}
