{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenSurveillanceDB Public API",
    "description": "Public read API for the OpenSurveillanceDB dataset of public surveillance cameras: paginated JSON lists, GeoJSON/CSV exports, per-record detail, search, nearby lookup, revision history, geocoding and raster tiles. The dataset is licensed ODbL 1.0 — see https://opensurveillancedb.org/api-docs for the full licence terms and usage limits. The write API (POST /api/cameras, PATCH /api/cameras/{id}, POST /api/corrections, PUT/DELETE /api/cameras/{id}/confirmation and /api/cameras/{id}/actions) requires a private API key with the matching scope, sent as `Authorization: Bearer <key>`.",
    "termsOfService": "https://opensurveillancedb.org/api-docs",
    "contact": {
      "name": "OpenSurveillanceDB",
      "url": "https://opensurveillancedb.org"
    },
    "license": {
      "name": "ODbL 1.0",
      "url": "https://opendatacommons.org/licenses/odbl/1-0/"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://opensurveillancedb.org",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Cameras",
      "description": "Camera records, lists, exports and revisions"
    },
    {
      "name": "Write",
      "description": "Authenticated write endpoints (API keys)"
    },
    {
      "name": "Geocoding",
      "description": "Place search and reverse geocoding"
    },
    {
      "name": "Tiles",
      "description": "OpenStreetMap raster tiles"
    },
    {
      "name": "System",
      "description": "Health and discovery"
    }
  ],
  "security": [],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness probe",
        "operationId": "healthGet",
        "description": "Reports worker liveness without touching the database. Used by monitoring and by the RFC 9727 API catalog status relation.",
        "responses": {
          "200": {
            "description": "Worker is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Worker error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "List public cameras (paginated JSON, GeoJSON or CSV)",
        "operationId": "camerasList",
        "description": "Main entry point to the dataset. Default is a paginated JSON list. Add bbox=west,south,east,north for a GeoJSON viewport response (the map endpoint) or a paginated JSON page inside the box. Add format=geojson or format=csv for complete dataset snapshots (rate-limited in a stricter export bucket, no pagination). Pass count=false to skip the full-set COUNT (total answers null; walk pages with nextOffset).",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Filter by camera kind (e.g. Fixed dome, PTZ).",
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-text search across titles, addresses and kinds.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "initial",
            "in": "query",
            "required": false,
            "description": "Alphabetical filter: first letter A-Z.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]$"
            }
          },
          {
            "name": "freshness",
            "in": "query",
            "required": false,
            "description": "Filter by freshness window.",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year",
                "all"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "alphabetical",
                "useful",
                "recent",
                "confirmations"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Verification state filter.",
            "schema": {
              "type": "string",
              "enum": [
                "confirmed",
                "never"
              ]
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "description": "Record origin filter.",
            "schema": {
              "type": "string",
              "enum": [
                "reports",
                "imported"
              ]
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Viewport as four decimals: west,south,east,north (e.g. 8.5,47.3,8.6,47.5). Requires format=geojson or the default JSON list.",
            "schema": {
              "type": "string",
              "example": "8.5,47.3,8.6,47.5"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response format. Omit for the paginated JSON list.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "csv"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (clamped to the maximum).",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Page offset, starts at 0.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Set to false to skip the full-set COUNT: total answers null and pagination walks on nextOffset.",
            "schema": {
              "type": "string",
              "enum": [
                "false",
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated JSON list (default / with bbox) — or GeoJSON FeatureCollection / CSV attachment when format is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraList"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Complete dataset as CSV attachment (Content-Disposition: attachment)."
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter (bad bbox, unknown sort/freshness/state/origin, invalid initial/limit/offset).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Write"
        ],
        "summary": "Publish a new camera report",
        "operationId": "camerasSubmit",
        "description": "Requires a private API key with scope `submit`. Authenticate with `Authorization: Bearer <key>`. CSRF-protected: an Origin header matching the site is required for browser callers.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraSubmission"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Camera created"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the submit scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable input (e.g. invalid direction)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cameras/{id}": {
      "get": {
        "tags": [
          "Cameras"
        ],
        "summary": "One camera record",
        "operationId": "cameraGet",
        "description": "Full public detail of a camera by numeric id: location, address, verification state, direction and change history references.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric camera id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The camera record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Camera"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Write"
        ],
        "summary": "Update camera details",
        "operationId": "cameraPatch",
        "description": "Requires a private API key with scope `edit`. Owner edits and edit requests.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Camera updated"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks the edit scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
