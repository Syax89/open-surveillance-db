        "summary": "Confirm a camera (community confirmation)",
        "operationId": "confirmationPut",
        "description": "Requires a private API key with scope `confirm`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
